configuration {
    modi:                "drun,filebrowser,window,run";
    show-icons:          true;
    drun-display-format: "{name}";

    display-drun:        " ";
    display-run:         " ";
    display-filebrowser: " ";
    display-window:      " ";

    hover-select:        true;
    me-select-entry:     "";
    me-accept-entry:     "MousePrimary";
    icon-theme:          "candy-icons";

    matching:            "prefix";
    tokenize:            false;
    case-sensitive:      false;
    sort:                true;
    sorting-method:      "levenshtein";
}

* {
    font:           "JetBrainsMono Nerd Font 11";
    bg:             #11111b; /* Gris casi negro, el abismo puro */
    bg-element:     transparent;
    bg-selected:    #89b4fa; /* Azul gélido eléctrico */
    bg-dock:        #181825B3;    
    bg-btn:         #313244; /* Gris intermedio para los botones apagados */
    bg-btn-active:  #89b4fa; /* Botón activo brilla en azul gélido */
    fg:             #cdd6f4; /* Texto principal en blanco grisáceo elegante */
    fg-muted:       #a6adc8; /* Texto apagado para los elementos no seleccionados */
    fg-btn:         #cdd6f4;
    fg-btn-active:  #11111b; /* Texto oscuro sobre el botón azul brillante */
    border-win:     #89b4fa; /* Borde de la ventana en azul épico */
    fg-prompt:      #89b4fa; /* La palabra "Search..." combinando con el tema */
}

window {
    location:         center;
    anchor:           center;
    width:            640px;
    background-color: transparent;
    background-image: linear-gradient(to bottom, #313244B3, #000000B3);
    border:           3px;
    border-color:     @border-win;
    border-radius:    22px;
}

mainbox {
    orientation:      horizontal;
    background-color: transparent;
    children:         [ "leftbox", "mode-switcher" ];
}

leftbox {
    orientation:      vertical;
    background-color: transparent;
    children:         [ "inputbar", "listview" ];
}

inputbar {
    enabled:          true;
    padding:          20px 20px 10px 20px;
    background-color: transparent;
    children:         [ "prompt", "entry" ];
}

entry {
    background-color:  transparent;
    text-color:        @fg;
    placeholder:       "Search...";
    placeholder-color: @fg-btn;
    padding:           0 10px;
}

prompt {
    background-color: transparent;
    text-color:       @fg-prompt;
}

listview {
    background-color: transparent;
    columns:          4;
    lines:            3;
    spacing:          10px;
    padding:          10px 20px 20px 20px;
    fixed-columns:    true;
    fixed-height:     true;
    cycle:            false;
}

element, element normal.normal, element alternate.normal {
    orientation:      vertical;
    padding:          10px;
    border-radius:    16px;
    spacing:          10px;
    background-color: transparent;
    children:         [ element-icon, element-text ];
}

element selected {
    background-color: @bg-selected;
}

element-icon {
    background-color: transparent;
    size:             64px;
    horizontal-align: 0.5;
}

element-text {
    background-color: transparent;
    text-color:       @fg-muted;
    horizontal-align: 0.5;
    font:             "JetBrainsMono Nerd Font 11";
}

element selected element-text {
    text-color: @bg; 
}

element-text highlight {
    text-color: @bg;
}

mode-switcher {
    background-color: @bg-dock;
    width:            85px;
    padding:          60px 10px;
    spacing:          20px;
    border-radius:    0 20px 20px 0;
    orientation:      vertical;
    children:         [ button ];
}

button {
    background-color: @bg-btn;
    text-color:       @fg-btn;
    border-radius:    50px;
    padding:          14px 0px;
    cursor:           pointer;
    horizontal-align: 0.5;
    vertical-align:   0.5;
}

button selected {
    background-color: @bg-btn-active;
    text-color:       @fg-btn-active;
}
